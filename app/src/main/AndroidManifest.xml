<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permiso para pedir la desinstalación de apps -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Consultas necesarias para Android 11+ (API 30+) -->
    <queries>
        <!-- 1. Para listar las apps instaladas en el cajón -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!-- 2. Para detectar los Icon Packs (Formato Categoría - ADW) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="org.adw.launcher.THEMES" />
        </intent>

        <!-- 3. Para detectar los Icon Packs (Formato Acción - Nova, GO, etc.) -->
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="com.gau.go.launcherex.theme" /></intent>
        <intent><action android:name="com.anddoes.launcher.THEME" /></intent>
        <intent><action android:name="com.teslacoilsw.launcher.THEME" /></intent>
    </queries>

    <application
        android:label="@string/app_name" 
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.MiLauncher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:appCategory="home">

        <!-- 
            configChanges: Evita que el launcher se reinicie al girar la pantalla.
            taskAffinity="": Evita conflictos con la pila de tareas del sistema.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- 
                    LAUNCHER comentado: Hace que tu propia app no aparezca en su propio cajón de apps.
                    Si quieres que "Juan Launcher" aparezca como una app más en tu cajón, descomenta la siguiente línea.
                -->
                <!-- <category android:name="android.intent.category.LAUNCHER" /> -->
            </intent-filter>
        </activity>
    </application>
</manifest>